# RideNow Security Configuration Template
# Copy this file to .env.local and populate with secure 256-bit hex keys:
# Generate with: openssl rand -hex 32

# 1. KMS Envelope Encryption Master Key (256-bit AES-GCM hex key)
RIDENOW_KMS_MASTER_KEY=your_256_bit_hex_master_key_here

# 2. Centralized Session Authentication Secret (256-bit HMAC secret)
RIDENOW_AUTH_SECRET=your_256_bit_hex_auth_secret_here

# 3. External Payment Gateway Webhook HMAC Secret (256-bit hex secret)
WEBHOOK_PAYMENT_SECRET=your_256_bit_hex_webhook_secret_here
